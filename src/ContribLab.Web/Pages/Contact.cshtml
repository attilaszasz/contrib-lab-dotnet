@page
@model ContribLab.Web.Pages.ContactModel
@{
    ViewData["Title"] = "Contact";
    ViewData["ActivePage"] = "Contact";
}

<h1 class="mb-3">Contact us</h1>
<p>Questions about an order? Send us a message and we will get back to you.</p>

<div class="alert alert-success" role="alert">
    Your message was sent successfully.
</div>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="ContactForm.Name" class="form-label"></label>
                <input asp-for="ContactForm.Name" class="form-control" />
                <span asp-validation-for="ContactForm.Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ContactForm.Email" class="form-label"></label>
                <input asp-for="ContactForm.Email" type="text" class="form-control" />
                <span asp-validation-for="ContactForm.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ContactForm.Message" class="form-label"></label>
                <textarea asp-for="ContactForm.Message" class="form-control" rows="4"></textarea>
                <span asp-validation-for="ContactForm.Message" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Send message</button>
        </form>
    </div>
</div>
