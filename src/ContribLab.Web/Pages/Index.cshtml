@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
    ViewData["ActivePage"] = "Home";
}

<div class="p-5 mb-4 bg-light rounded-3">
    <div class="container-fluid py-2">
        <h1 class="display-5 fw-bold">Contoso Corner Shop</h1>
        <p class="lead">
            A small sample storefront used for GitHub contribution training.
            Browse the catalog, add items to your cart, and say hello.
        </p>
        <a class="btn btn-primary btn-lg" asp-page="/Products/Index">Browse products</a>
    </div>
</div>

<h2 class="mb-3">Featured products</h2>
<div class="row">
    @foreach (var product in Model.FeaturedProducts)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="h5 card-title">@product.Name</h3>
                    <p class="card-text">@product.Description</p>
                    <p class="card-text fw-bold">@product.Price.ToString("C")</p>
                </div>
            </div>
        </div>
    }
</div>

<p class="mt-3">
    Learn more about the tools used to build this site on the
    <a href="https://dotnet.microsoft.com/" target="_blank">.NET website</a>.
</p>
